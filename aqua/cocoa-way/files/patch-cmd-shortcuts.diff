+// macOS 12 and later move a key equivalent to whichever key types its character with Cmd on
+// the active layout: on Belgian AZERTY, Cmd+1 lands on the & key, and Cmd+& no longer reaches
+// the guest. Keep each equivalent on its own character. macOS 11 has no such property.
+unsafe fn keep_key_equivalent(item: &NSMenuItem) {
+    unsafe {
+        let responds: bool =
+            msg_send![item, respondsToSelector: sel!(setAllowsAutomaticKeyEquivalentLocalization:)];
+        if responds {
+            item.setAllowsAutomaticKeyEquivalentLocalization(false);
+        }
+    }
+}
