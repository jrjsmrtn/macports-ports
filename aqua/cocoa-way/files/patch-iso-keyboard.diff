+// macOS virtual key codes, from HIToolbox's Events.h.
+const KVK_ISO_SECTION: u16 = 0x0a;
+const KVK_ANSI_GRAVE: u16 = 0x32;
+const KVK_JIS_UNDERSCORE: u16 = 0x5e;
+const KVK_JIS_KEYPAD_COMMA: u16 = 0x5f;
+const KVK_JIS_EISU: u16 = 0x66;
+const KVK_JIS_KANA: u16 = 0x68;
+
+/// The physical layout of a keyboard, as KBGetLayoutType reports it.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum KeyboardLayout {
+    Ansi,
+    Iso,
+    Jis,
+    Unknown,
+}
+
+impl KeyboardLayout {
+    pub fn from_layout_type(layout_type: u32) -> Self {
+        match &layout_type.to_be_bytes() {
+            b"ANSI" => Self::Ansi,
+            b"ISO " => Self::Iso,
+            b"JIS " => Self::Jis,
+            _ => Self::Unknown,
+        }
+    }
+}
+
+/// The evdev code for a key Winit reports as Backquote, which it does for both
+/// kVK_ANSI_Grave and kVK_ISO_Section. On an ISO keyboard macOS reports the key
+/// below Escape as kVK_ISO_Section and the key beside left Shift as
+/// kVK_ANSI_Grave, so they are mapped as Linux's hid_apple does with iso_layout=1.
+pub fn backquote_key(mac_keycode: Option<u16>, layout: KeyboardLayout) -> u32 {
+    match (mac_keycode, layout) {
+        (Some(KVK_ANSI_GRAVE), KeyboardLayout::Iso) => 86,
+        // The key below Escape, whatever the layout.
+        (Some(KVK_ISO_SECTION), _) => 41,
+        _ => 41,
+    }
+}
+
+/// The macOS key code of the key event AppKit is dispatching, which Winit's
+/// KeyEvent does not carry.
+pub fn current_mac_keycode() -> Option<u16> {
+    let mtm = MainThreadMarker::new()?;
+    let event = NSApplication::sharedApplication(mtm).currentEvent()?;
+    match unsafe { event.r#type() } {
+        NSEventType::KeyDown | NSEventType::KeyUp => Some(unsafe { event.keyCode() }),
+        _ => None,
+    }
+}
+
+/// The layout of the keyboard last typed on.
+pub fn current_layout() -> KeyboardLayout {
+    KeyboardLayout::from_layout_type(unsafe { KBGetLayoutType(LMGetKbdType().into()) })
+}
