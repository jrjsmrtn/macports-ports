+        assert_eq!(map_key(native(KVK_JIS_UNDERSCORE)), Some(89));
+        assert_eq!(map_key(native(KVK_JIS_KEYPAD_COMMA)), Some(121));
+        assert_eq!(map_key(native(KVK_JIS_KANA)), Some(122));
+        assert_eq!(map_key(native(KVK_JIS_EISU)), Some(123));
+        assert_eq!(map_key(native(0x34)), None);
