+    #[test]
+    fn layout_types_are_four_character_codes() {
+        assert_eq!(KeyboardLayout::from_layout_type(0x414e_5349), KeyboardLayout::Ansi);
+        assert_eq!(KeyboardLayout::from_layout_type(0x4953_4f20), KeyboardLayout::Iso);
