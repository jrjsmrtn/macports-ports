PortSystem          1.0
PortGroup           cargo   1.0
PortGroup           github  1.0

github.setup        J-x-Z cocoa-way 2.1.0 v
github.tarball_from archive
revision            0

description         Native macOS Wayland compositor for Linux applications

long_description    {*}${description}. Cocoa-Way renders Wayland clients \
                    with Metal in native macOS windows. Linux applications \
                    reach it through Waypipe, over SSH or from a container \
                    (Apple container, Docker, OrbStack).

categories          aqua x11
installs_libs       no
license             GPL-3
maintainers         @jrjsmrtn openmaintainer
platforms           {darwin >= 20}

checksums           ${distname}${extract.suffix} \
                    rmd160  e29f18646259cd3bc0854b90a8b836b17234e362 \
                    sha256  107b9aeeebd3efbd7702c03fd1580634f1786ae4e32c55c5c4a9f029f66b549a \
                    size    2628082

depends_build-append \
                    path:bin/pkg-config:pkgconfig

depends_lib-append  port:libxkbcommon \
                    port:xkeyboard-config

# The keyboard data is searched for in Homebrew's and Nix's prefixes only.
patchfiles          patch-xkb-prefix.diff
# Apple ISO keyboards: the keys below Escape and beside left Shift both
# reached clients as KEY_GRAVE.
patchfiles-append   patch-iso-keyboard.diff
# Cmd shortcuts for the guest: macOS 12+ relocalised Cocoa-Way's key equivalents (Cmd+1 moved
# to the & key on AZERTY), and AppKit's system shortcuts took the rest (Cmd+Shift+/).
patchfiles-append   patch-cmd-shortcuts.diff

post-patch {
    reinplace "s|@PREFIX@|${prefix}|g" ${worksrcpath}/src/runtime_paths.rs
}

build.args-append   -p ${name} --bins

test.run            yes
test.cmd            ${cargo.bin} test
# The default target, "test", would be passed to cargo as a test name filter.
test.target
test.args           --target [cargo.rust_platform] -p ${name}

destroot {
    foreach bin {cocoa-way cocoa-wayctl cocoa-way-mcp} {
        xinstall -m 0755 \
            ${worksrcpath}/target/[cargo.rust_platform]/release/${bin} \
            ${destroot}${prefix}/bin/
    }
    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE README.md ${docdir}
}

