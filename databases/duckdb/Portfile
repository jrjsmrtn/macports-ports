foreach ext [lsort [array names known_extensions]] {
    subport ${name}-${ext} {}
}

if {${subport} ne ${name}} {
    set ext         [string range ${subport} [string length ${name}-] end]
    set platform    [expr {${build_arch} eq "arm64" ? "osx_arm64" : "osx_amd64"}]
    description     DuckDB's ${ext} extension
    long_description \
        DuckDB's own signed build of its ${ext} extension, installed where \
        DuckDB finds it by name.
    set entry       $known_extensions(${ext})
    license         {*}[expr {[dict exists ${entry} license] ? [dict get ${entry} license] : "MIT"}]
    set archs       {}
    foreach {p a} {osx_arm64 arm64 osx_amd64 x86_64} {
        if {[dict exists ${entry} ${p}]} {lappend archs ${a}}
    }
    supported_archs {*}${archs}
    universal_variant no
    # A signed binary: none of the main port's OpenSSL handling applies.
    openssl.branch  no_version
    # DuckDB's macOS extensions are built for macOS 11 and later.
    platforms       {darwin >= 20}

    master_sites    https://extensions.duckdb.org/v${version}/${platform}/
    distname        ${ext}.duckdb_extension
    extract.suffix  .gz
    dist_subdir     ${name}/v${version}/${platform}
    # Only where DuckDB publishes the file; supported_archs excludes the rest.
    # md5 is not a checksum here: livecheck compares it with the published
    # file, which DuckDB can replace at the same URL after a release.
    if {[dict exists ${entry} ${platform}]} {
        checksums   {*}[dict remove [dict get ${entry} ${platform}] md5]
        livecheck.type  md5
        livecheck.url   ${master_sites}${distname}${extract.suffix}
        livecheck.md5   [dict get ${entry} ${platform} md5]
    }
    extract.only
    depends_build-delete \
                    path:bin/cmake:cmake port:ninja
    depends_lib     port:${name}
    if {[dict exists ${entry} depends]} {
        foreach dep [dict get ${entry} depends] {
            depends_lib-append port:${name}-${dep}
        }
    }
    if {[dict exists ${entry} notes]} {
        notes       [dict get ${entry} notes]
    }
    use_configure   no

    build {
        xinstall -d ${workpath}/ext/v${version}/${platform}
        system "gunzip -c [shellescape ${distpath}/${distfiles}] > [shellescape ${workpath}/ext/v${version}/${platform}/${ext}.duckdb_extension]"
    }
    # The file must load into the installed DuckDB, from a directory named at
    # run time, with an empty HOME and nothing downloaded.
    test.run        yes
    test {
        # ui writes into ~/.duckdb and fails if it is missing (duckdb-ui#203).
        file mkdir ${workpath}/home/.duckdb
        # The installed extensions follow this one's, for its depends.
        set sql "SET autoinstall_known_extensions=false;\
                 SET extension_directories=\['[string map {' ''} ${workpath}/ext]',\
                     '[string map {' ''} ${extension_dir}]'\];\
                 LOAD ${ext};\
                 SELECT loaded FROM duckdb_extensions()\
                     WHERE extension_name = '${ext}';"
        system -W ${workpath} "env HOME=[shellescape ${workpath}/home]\
            ${prefix}/bin/duckdb -csv -noheader -c [shellescape ${sql}]\
            | grep -qx true"
        if {[llength [glob -nocomplain ${workpath}/home/.duckdb/extensions/*/*/*]] > 0} {
            return -code error "a download reached ${workpath}/home"
        }
    }
    destroot {
        xinstall -d ${destroot}${extension_dir}/v${version}/${platform}
        xinstall -m 0644 ${workpath}/ext/v${version}/${platform}/${ext}.duckdb_extension \
            ${destroot}${extension_dir}/v${version}/${platform}/
    }
} else {
    patchfiles-append   no-ccache.patch \
                        no-clangd-cache.patch

    set python_version  314
    set python_branch   \
        [string index ${python_version} 0].[string range ${python_version} 1 end]

    configure.args-append \
                        -DBUILD_EXTENSIONS='autocomplete\;icu\;parquet\;json' \
                        -DENABLE_EXTENSION_AUTOLOADING=1 \
                        -DENABLE_EXTENSION_AUTOINSTALL=0 \
                        -DEXTENSION_DIRECTORIES='~/.duckdb/extensions\;${prefix}/lib/duckdb/extensions' \
                        -DOVERRIDE_GIT_DESCRIBE=v${version} \
                        -DCMAKE_CXX_STANDARD=14 \
                        -DPython3_EXECUTABLE=${prefix}/bin/python${python_branch}

    # C++14 for std::hash on enum class keys; older libc++ lacks it in C++11 mode
    compiler.cxx_standard 2014

    depends_build-append \
                        port:pkgconfig \
                        port:python${python_version} \
                        port:zstd

    if {[string match *gcc* ${configure.compiler}]} {
        # Without the following setting, the build fails miserably at linking with every possible symbol undefined.
        # Undefined symbols: __ZNK6duckdb5Value14GetValueUnsafeItEET_v, __ZN6duckdb11LogicalType3MAPES0_S0_ etc.
        configure.args-append \
                        -DEXTENSION_STATIC_BUILD=TRUE
        configure.ldflags-append \
                        -latomic
    }

    # DuckDB's sqlite, httpfs and postgres extensions,
    # built into the library unconditionally, at the commits DuckDB pins for
    # this release (.github/config/extensions/*.cmake), each linked to the
    # MacPorts library it needs instead of the copy it would bundle. Each entry
    # names its repository under github.com/duckdb, its commit and checksums,
    # and optionally the patches to apply and paths to delete, in that order;
    # whether it compiles database-connector; and the tests of its suite to
    # skip. postgres_scanner's second patch renames its AttachFunctionData,
    # which shares a name with the SQLite scanner's: with both in one library,
    # postgres_attach got the wrong one. Its skipped test runs INSTALL httpfs;
    # httpfs's skipped tests fail offline or compare live responses.
    set static_extensions {
        sqlite_scanner {
            repo        duckdb-sqlite
            commit      5274128259f73166c1f37f01190a4601f84c5525
            checksums { \
                rmd160 fca4cc0fcd82a64e3de861552a4e7fd473632d34 \
                sha256 3e5838119233985a3b2cb96afb7e80d5f86a6a7fe894ee0ce65c73d7554f2f82 \
                size 4702656
            }
            patches     patch-sqlite-scanner-system-sqlite.diff
            delete      src/sqlite
            connector   yes
        }
        httpfs {
            repo        duckdb-httpfs
            commit      4bc690dba4496c765777a0269d48fdbaff7cdc11
            checksums { \
                rmd160 4bc96d752db32ab3b4383758e4d7408a4a33f1fa \
                sha256 094aef2364bdfb2fe69dca03b6a53723a25e8cc5ccd08b057cf797892d487e6f \
                size 145022
            }
            skip_tests {
                test/sql/connection_caching.test
                test/sql/copy/s3/glob_s3_recursive.test_slow
                test/sql/curl_client/test_load_other_extensions.test
                test/sql/logging/http_logging.test
                test/sql/s3/connection_caching_s3.test
            }
        }
        postgres_scanner {
            repo        duckdb-postgres
            commit      318dabb2474fc3789b0199301a2e661e19c1b4fc
            checksums { \
                rmd160 7024edf72893d271d0e02c7dc063df9c0c820f5c \
                sha256 6c063c0149914c63e43a876fdd68c72aafe9f0943ab600fea6a1cb826eb570cb \
                size 322992
            }
            patches {
                patch-postgres-scanner-link-builtin.diff
                patch-postgres-scanner-attach-data.diff
            }
            connector   yes
            skip_tests  test/sql/storage/attach_secret_storage.test
        }
    }
    # The source directory of each, as extracted.
    dict for {ext entry} ${static_extensions} {
        set static_dir(${ext}) \
            ${workpath}/[dict get ${entry} repo]-[dict get ${entry} commit]
    }

    # Both scanners compile database-connector, a git submodule each pins at
    # its own commit, into the one library. Both get postgres's pin, so that
    # the definitions they share are the same code.
    set database_connector_commit 0a8505f775dae7bb30edd37f848d5975bf72884e
    set pg                      postgresql18

    dict for {ext entry} ${static_extensions} {
        set distfile [dict get ${entry} repo]-[dict get ${entry} commit].tar.gz
        master_sites-append https://codeload.github.com/duckdb/[dict get ${entry} repo]/tar.gz/[dict get ${entry} commit]?dummy=:${ext}
        distfiles-append    ${distfile}:${ext}
        checksums-append    ${distfile} {*}[dict get ${entry} checksums]
    }
    master_sites-append https://codeload.github.com/duckdb/database-connector/tar.gz/${database_connector_commit}?dummy=:connector
    distfiles-append    database-connector-${database_connector_commit}.tar.gz:connector
    checksums-append    database-connector-${database_connector_commit}.tar.gz \
                        rmd160  78bc8c447419b728983b2932f490839763b897c1 \
                        sha256  75183a89b801ce7a172594580665ce321684e6831dbb632d8770be94b166e07b \
                        size    168707

    # sqlite: the sqlite3 port's library instead of its bundled SQLite 3.38.1.
    # httpfs: curl and OpenSSL, and DuckDB's own mbedtls, which libduckdb
    # already carries. postgres: postgresql18's libpq (it uses libpq's OAuth
    # hooks, new in PostgreSQL 18), linked into the built-in form by a patch,
    # as upstream builds it loadable only.
    depends_lib-append  port:sqlite3 \
                        port:curl \
                        port:${pg}
    configure.args-append \
                        -DSQLite3_INCLUDE_DIR=${prefix}/include \
                        -DSQLite3_LIBRARY=${prefix}/lib/libsqlite3.dylib \
                        -DCURL_INCLUDE_DIR=${prefix}/include \
                        -DCURL_LIBRARY=${prefix}/lib/libcurl.dylib \
                        -DPostgreSQL_INCLUDE_DIR=${prefix}/include/${pg} \
                        -DPostgreSQL_LIBRARY=${prefix}/lib/${pg}/libpq.dylib \
                        -DDUCKDB_EXTENSION_CONFIGS=${workpath}/extensions.cmake

    post-extract {
        set fd [open ${workpath}/extensions.cmake w]
        dict for {ext entry} ${static_extensions} {
            if {[dict exists ${entry} connector]} {
                delete $static_dir(${ext})/database-connector
                copy ${workpath}/database-connector-${database_connector_commit} \
                    $static_dir(${ext})/database-connector
            }
            puts ${fd} "duckdb_extension_load(${ext}"
            puts ${fd} "    SOURCE_DIR $static_dir(${ext})"
            puts ${fd} "    EXTENSION_VERSION [string range [dict get ${entry} commit] 0 9])"
        }
        # Loadable only, not linked into the library: the postgres_scanner suite
        # generates its test database with them.
        puts ${fd} "duckdb_extension_load(tpch DONT_LINK)"
        puts ${fd} "duckdb_extension_load(tpcds DONT_LINK)"
        close ${fd}
    }
    post-patch {
        dict for {ext entry} ${static_extensions} {
            if {[dict exists ${entry} patches]} {
                foreach patch [dict get ${entry} patches] {
                    system -W $static_dir(${ext}) \
                        "${patch.cmd} -p0 < [shellescape ${filespath}/${patch}]"
                }
            }
            if {[dict exists ${entry} delete]} {
                foreach path [dict get ${entry} delete] {
                    delete $static_dir(${ext})/${path}
                }
            }
        }
    }

    # DuckDB's own suites, run by the unittest runner every build already
    # links: the core suite, then each built-in extension's.
    # postgres_scanner's runs against a throwaway server (files/postgres-test.sh).
    test.run            yes

    # Most tests that reach the network skip themselves when a request fails
    # with an HTTP error. These do not: they fail offline, or compare live
    # responses. Each static extension's own are in static_extensions.
    set unittest_skip(core) {
        test/extension/install_extension_httpfs.test
        test/sql/attach/remote_file_concurrently.test
        test/sql/attach/attach_remote_http_logging.test
    }

    test {
        # The remote optimizer test forks, and macOS aborts the child when it
        # touches the Objective-C runtime; ~[.] keeps the default hidden set out.
        set suites [list core ${worksrcpath} \
            {~[.] ~"Test using a remote optimizer pass in case thats important to someone"}]
        dict for {ext entry} ${static_extensions} {
            lappend suites ${ext} $static_dir(${ext}) {test/*}
            set unittest_skip(${ext}) [expr {[dict exists ${entry} skip_tests] \
                ? [dict get ${entry} skip_tests] : {}}]
        }
        foreach {suite dir spec} ${suites} {
            set args "--test-dir [shellescape ${dir}]"
            if {[llength $unittest_skip(${suite})] > 0} {
                set config ${workpath}/unittest-${suite}.json
                set paths {}
                foreach path $unittest_skip(${suite}) {
                    lappend paths "\"${path}\""
                }
                set fd [open ${config} w]
                puts ${fd} "{\"skip_tests\": \[{\"reason\": \"network\", \"paths\": \[[join ${paths} {, }]\]}\]}"
                close ${fd}
                append args " --test-config [shellescape ${config}]"
            }
            set cmd "[shellescape ${build.dir}/test/unittest] ${args} [shellescape ${spec}]"
            if {${suite} eq "postgres_scanner"} {
                set cmd "/bin/sh [shellescape ${filespath}/postgres-test.sh] \
                    [shellescape ${prefix}/lib/${pg}/bin] [shellescape ${build.dir}] \
                    [shellescape ${dir}] [shellescape ${workpath}/pg] ${cmd}"
            }
            ui_info "Running DuckDB's ${suite} tests"
            # The libcurl httpfs uses honours http_proxy, which MacPorts
            # exports from proxy_http; requests to the suites' local servers
            # must not go through it.
            system -W ${dir} "env no_proxy=localhost,127.0.0.1 NO_PROXY=localhost,127.0.0.1 ${cmd}"
        }
    }
}
