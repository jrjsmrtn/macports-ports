PortSystem          1.0
PortGroup           cargo   1.0
PortGroup           github  1.0

github.setup        J-x-Z waypipe-darwin 0.11.2 v -darwin.1
github.tarball_from archive
revision            0

description         Proxy for Wayland clients, with macOS support

long_description    {*}${description}. Waypipe forwards the Wayland protocol \
                    between a client and a compositor on another machine or \
                    in a container, over SSH or a Unix socket. This fork of \
                    Waypipe adds the shared memory and socket handling it \
                    needs to run on macOS, for example with Cocoa-Way.

categories          net x11
installs_libs       no
license             GPL-3+
maintainers         @jrjsmrtn openmaintainer

checksums           ${distname}${extract.suffix} \
                    rmd160  59e55da220b97dc7e828cdf4ee7a54bd4ddeb38d \
                    sha256  c273ee104a00a7b91d8ba4a7a7df0ff79b0b0ce1e724985685bb86b5c2cd5fa6 \
                    size    588841

depends_build-append \
                    port:scdoc

# Without lz4 and zstd compression, whose wrappers need the bindgen tool. DMA-BUF,
# GBM and video are Linux-only.
build.args-append   --no-default-features

post-build {
    system -W ${worksrcpath} "${prefix}/bin/scdoc < waypipe.scd > waypipe.1"
}

test.run            yes
test.cmd            ${cargo.bin} test
# The default target, "test", would be passed to cargo as a test name filter.
test.target
test.args           --target [cargo.rust_platform] \
                    --no-default-features --features test_proto

destroot {
    xinstall -m 0755 \
        ${worksrcpath}/target/[cargo.rust_platform]/release/waypipe \
        ${destroot}${prefix}/bin/
    xinstall -m 0644 ${worksrcpath}/waypipe.1 ${destroot}${prefix}/share/man/man1/
    set docdir ${destroot}${prefix}/share/doc/${name}
    xinstall -d ${docdir}
    xinstall -m 0644 -W ${worksrcpath} LICENSE.GPLv3 LICENSE.MIT README.md ${docdir}
}

